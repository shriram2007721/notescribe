# Public, build-time settings for the web app. NEVER put secrets in NEXT_PUBLIC_* variables:
# they are embedded in the browser bundle.

# Optional default URL of your NoteScribe AI proxy (ai-proxy/). Users can also set it in Settings.
NEXT_PUBLIC_AI_PROXY_URL=https://notescribe-ai-proxy.your-subdomain.workers.dev

# Only for sub-path hosting such as GitHub Pages (set automatically by the GitHub Actions workflow).
# NEXT_PUBLIC_BASE_PATH=/notescribe
